---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import ProjectFooter from '../components/ProjectFooter.astro';
import { docsPath } from '../../scripts/docs-routing.mjs';

// Replace the PDFs in public/whitepapers/ as new drafts become available.
const papers = [
  {
    id: 'thruput',
    category: '01 / System design',
    title: 'Project Thruput',
    pdf: null,
    summary: 'The main whitepaper introduces the case for abundant blockchain compute. It explores unordered transactions within blocks, concurrent updates to shared state, and the system architecture and capacity model behind Project Thruput.',
    audience: 'White paper coming October 29. Stay tuned.',
  },
  {
    id: 'fba-bridging',
    category: '02 / Consensus research',
    title: 'Trust-minimized bridging between FBA blockchains',
    pdf: '/whitepapers/fba-bridging.pdf',
    summary: 'This research paper explores how Federated Byzantine Agreement (FBA) can extend across blockchains. It presents a way for one chain to agree on another’s state, enabling asset transfers without giving an external third party custody of the escrowed assets.',
    audience: 'For readers interested in consensus protocols, trust assumptions, and cross-chain interoperability.',
  },
];
---

<StarlightPage
  hasSidebar={true}
  frontmatter={{
    title: 'Whitepapers',
    description: 'Read the whitepapers on Project Thruput’s system design and trust-minimized bridging between FBA blockchains.',
    template: 'splash',
    tableOfContents: false,
    prev: false,
    next: false,
  }}
>
  <div class="whitepapers-page site-page not-content">
    <div class="papers-container">
      <header class="papers-intro">
        <p class="eyebrow">Project Thruput / Research</p>
        <h1 id="_top">Whitepapers</h1>
        <p class="intro">The ideas behind Project Thruput, from the system design to research on connecting blockchains.</p>
      </header>

      <div class="papers">
        {papers.map(paper => (
          <article id={paper.id} aria-labelledby={`${paper.id}-title`}>
            <p class="eyebrow">{paper.category}</p>
            <div class="paper-content">
              <h2 id={`${paper.id}-title`}>{paper.title}</h2>
              <p class="summary">{paper.summary}</p>
              <p class="audience">{paper.audience}</p>
              {paper.pdf && <div class="paper-links">
                <a href={paper.pdf} aria-label={`Read ${paper.title} (PDF)`}>Read PDF <span aria-hidden="true">↗</span></a>
                <a href={paper.pdf} download aria-label={`Download ${paper.title} (PDF)`}>Download PDF</a>
              </div>}
            </div>
          </article>
        ))}
      </div>

      <aside class="continue-reading" aria-label="Continue exploring">
        <a href={docsPath('/architecture/')}>Understand Project Thruput <span aria-hidden="true">↗</span></a>
      </aside>
      <ProjectFooter />
    </div>
  </div>
</StarlightPage>

<style>
  .whitepapers-page { color: var(--brand-foreground); background: var(--brand-background); font-family: var(--sl-font); }
  .papers-container { width: calc(100% - 2.5rem); max-width: 77.5rem; margin-inline: auto; }
  .papers-intro { max-width: 45rem; padding-block: 4rem 3rem; }
  .eyebrow { margin: 0; color: var(--brand-muted); font: 400 .75rem/1.5 var(--sl-font-mono); letter-spacing: .06em; }
  h1 { margin: 1rem 0 1.5rem; font-size: clamp(2.75rem, 6vw, 4.75rem); font-weight: 500; line-height: 1.1; letter-spacing: -.045em; }
  .intro { margin: 0; font-size: 1.25rem; line-height: 1.6; text-wrap: pretty; }
  article { display: grid; gap: 1rem; padding-block: 2.5rem; border-top: 1px solid var(--brand-border); scroll-margin-top: calc(var(--sl-nav-height) + 1rem); }
  .paper-content { max-width: 46rem; }
  h2 { margin: 0; font-size: clamp(1.75rem, 3vw, 2.5rem); font-weight: 500; line-height: 1.25; letter-spacing: -.035em; text-wrap: balance; }
  .summary { margin: 1.25rem 0 0; color: var(--brand-muted); line-height: 1.7; }
  .audience { margin: 1rem 0 0; line-height: 1.6; }
  .paper-links { display: flex; flex-wrap: wrap; gap: .5rem 1.5rem; margin-top: 1.5rem; }
  .paper-links a { display: inline-flex; align-items: center; gap: .375rem; min-height: 2.75rem; }
  .continue-reading { padding-block: 2rem; border-block: 1px solid var(--brand-border); }
  a { color: var(--sl-color-text-accent); text-decoration: none; }
  a:hover { text-decoration: underline; text-underline-offset: .25em; }
  @media (min-width: 50rem) {
    .papers-container { width: calc(100% - 4rem); }
    .papers-intro { padding-block: 5rem 4rem; }
    article { grid-template-columns: 1fr 3fr; gap: 2rem; padding-block: 3rem; }
    article > .eyebrow { padding-top: .5rem; }
  }
  @media (min-width: 1101px) { .papers-container { width: calc(100% - 6rem); } }
</style>
