---
import { docsPath } from '../../scripts/docs-routing.mjs';
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";
import AgentPrompt from "../components/home/AgentPrompt.astro";
import DotField from "../components/home/DotField.astro";
import SharedState from "../components/home/SharedState.astro";
import CounterExample from "../components/home/CounterExample.astro";
import ValidatorScale from "../components/home/ValidatorScale.astro";
import ExecutionScaling from "../components/home/ExecutionScaling.astro";
import ProjectFooter from "../components/ProjectFooter.astro";

const steps = [
    ["01", "Create", "Start a project with the CLI.", "/cli/create-project/"],
    ["02", "Write", "Define contract logic in Rust.", "/contracts/"],
    ["03", "Test", "Check native and RV32 execution.", "/cli/build-and-test/"],
    ["04", "Deploy", "Fund and initialize on Devnet.", "/cli/deploy-and-call/"],
    ["05", "Connect", "Call with typed bindings.", "/typescript/"],
];
---

<StarlightPage
    hasSidebar={true}
    frontmatter={{
        title: "Stellar Thruput",
        description:
            "Stellar Thruput explores abundant compute through unordered transactions within each block, shared state, and runtime-enforced constraints.",
        template: "splash",
        pagefind: false,
        prev: false,
        next: false,
    }}
>
    <div class="home-page not-content">
        <noscript>
            <nav class="home-fallback" aria-label="Site navigation">
                <a href={docsPath('/get-started/')}>Documentation</a>
                <a href={docsPath('/start/build-with-an-agent/')}>Build with an agent</a>
            </nav>
        </noscript>
        <section id="hero" aria-labelledby="_top">
            <DotField />
            <div class="home-container hero-content">
                <h1 id="_top">
                    Blockchain technology <br />
                    <span class="hero-final-line">built for <span class="abundance">abundance<span class="hero-cursor" aria-hidden="true">_</span></span></span>
                </h1>
                <p class="hero-description">
                    Parallel execution. Unordered transactions. <br />
                    Shared balances without overspending. <br />
                    No conventional gas fees.
                </p>
                <AgentPrompt />
                <nav class="hero-links" aria-label="Start exploring">
                    <a href={docsPath('/get-started/contract/')}>
                        Follow the guided quickstart{" "}
                        <span aria-hidden="true">↗</span>
                    </a>
                    <a href={docsPath('/architecture/')}>
                        Understand Stellar Thruput{" "}
                        <span aria-hidden="true">↗</span>
                    </a>
                </nav>
            </div>
        </section>

        <section class="home-section" aria-labelledby="shared-state">
            <div class="home-container split">
                <div class="section-copy">
                    <p class="eyebrow">01 / A different starting point</p>
                    <h2 id="shared-state">
                        Payments need rules.
                        <br />
                        Do they need an order?
                    </h2>
                    <p>
                        Stellar Thruput is a moonshot inspired by
                        <a href="https://stellar.org/foundation">Stellar’s mission</a>.
                        It looks a decade ahead, exploring the compute and
                        throughput a globally accessible financial system could
                        need.
                    </p>
                    <p>
                        Thruput removes transaction order within each block to
                        unlock parallel execution, even across shared balances.
                        Typed storage lets compatible changes combine, while
                        the runtime enforces application constraints and
                        prevents overspending.
                    </p>
                    <p>
                        Example: Three payments read the same starting balance of 100.
                        Payments of 30 and 40 can land together, leaving 30.
                        Admitting a payment of 50 as well would overspend, so it
                        is excluded. The diagram shows one possible selection.
                    </p>
                    <p>
                        Blocks still form an ordered history. Within each block,
                        admitted changes combine into the next committed state.
                    </p>
                    <a class="text-link" href={docsPath('/how-it-works/execution-model/')}>
                        Explore the execution model{" "}
                        <span aria-hidden="true">↗</span>
                    </a>
                </div>
                <SharedState />
            </div>
        </section>

        <section class="home-section differences" aria-labelledby="differences">
            <div class="home-container differences-layout">
                <div class="section-copy">
                    <p class="eyebrow">02 / Why Stellar Thruput</p>
                    <h2 id="differences">More compute. More throughput.</h2>
                    <p>
                        The bet is that removing transaction order within
                        blocks can unlock far more computation for smart contracts,
                        because compatible transactions can run together instead
                        of taking turns.
                        Work pushed offchain by compute limits could move onchain.
                    </p>
                    <p>
                        Higher throughput follows from the same design, even
                        across shared state. The aim is a new baseline: if an
                        application makes sense onchain, compute and throughput
                        should not hold it back.
                    </p>
                </div>
                <div class="difference-list">
                    <article id="concurrency">
                        <span class="number">01</span>
                        <div>
                            <h3>Rules across shared state</h3>
                            <p>
                                A transaction can check its own changes. A
                                capacity constraint can also enforce a shared
                                withdrawal budget across concurrent transactions.
                                The SDK provides storage types for both merge
                                rules and constraints on their combined changes.
                            </p>
                            <a
                                class="text-link"
                                href={docsPath('/programming-model/storage-types/')}
                            >
                                Choose your storage{" "}
                                <span aria-hidden="true">↗</span>
                            </a>
                        </div>
                    </article>
                    <article id="compute">
                        <span class="number">02</span>
                        <div>
                            <h3>No conventional gas fees</h3>
                            <p>
                                Gas meters computation without a token fee or
                                burn. We’re exploring whether a trader on Wall
                                Street and a farmer in Kenya can pay the same
                                transaction fee: zero.
                            </p>
                            <a
                                class="text-link"
                                href={docsPath('/programming-model/execution/#gas')}
                            >
                                Understand gas limits{" "}
                                <span aria-hidden="true">↗</span>
                            </a>
                        </div>
                    </article>
                    <article id="capacity">
                        <span class="number">03</span>
                        <div>
                            <h3>Balance-based capacity</h3>
                            <p>
                                Thruput tries to get as much work done as capacity
                                allows, instead of rationing it. Under load,
                                unlocked native-token balances determine each
                                account's share of
                                scheduling capacity over time. A root transaction's
                                declared gas limit determines how much capacity
                                it uses.
                            </p>
                            <a
                                class="text-link"
                                href={docsPath('/how-it-works/storage-economics/#balance-proportional-scheduling')}
                            >
                                Explore scheduling{" "}
                                <span aria-hidden="true">↗</span>
                            </a>
                        </div>
                    </article>
                    <article id="storage">
                        <span class="number">04</span>
                        <div>
                            <h3>Refundable storage deposits</h3>
                            <p>
                                Stored data locks native tokens as a deposit.
                                Delete the data to reclaim that deposit.
                            </p>
                            <a
                                class="text-link"
                                href={docsPath('/how-it-works/storage-economics/#storage-refundable-deposits')}
                            >
                                Understand storage deposits{" "}
                                <span aria-hidden="true">↗</span>
                            </a>
                        </div>
                    </article>
                </div>
            </div>
        </section>

        <section class="home-section" aria-labelledby="validator-architecture">
            <div class="home-container architecture-layout">
                <div class="section-copy architecture-heading">
                    <p class="eyebrow">03 / Architecture</p>
                    <h2 id="validator-architecture">
                        One validator. Many machines.
                    </h2>
                </div>
                <div class="split architecture-intro">
                    <div class="section-copy">
                        <p>
                            A Thruput validator is itself a distributed system.
                            A high performance RPC system connects scheduling,
                            authentication, and smart-contract execution across
                            machines.
                        </p>
                        <p>
                            Authentication and smart-contract execution use this
                            model today. Extending it to state is part of the
                            longer-term plan.
                        </p>
                    </div>
                    <div class="section-copy">
                        <p>
                            Need more execution capacity? Add executor machines.
                            The goal is to make throughput a hardware-sizing
                            question: start with the work your application needs,
                            then size the compute to match.
                        </p>
                        <a class="text-link" href={docsPath('/how-it-works/architecture/')}>
                            Explore the architecture{" "}
                            <span aria-hidden="true">↗</span>
                        </a>
                    </div>
                </div>
                <ValidatorScale />
                <ExecutionScaling />
            </div>
        </section>

        <section
            class="home-section developer-section"
            aria-labelledby="developer-experience"
        >
            <div class="home-container">
                <div class="split">
                    <div class="section-copy">
                        <p class="eyebrow">04 / From contract to application</p>
                        <h2 id="developer-experience">
                            Write Rust. Build something you can use.
                        </h2>
                        <p>
                            Create, test, deploy, and inspect contracts with a
                            complete CLI. Generate TypeScript bindings to call
                            them from your application. Give your coding agent
                            the <code>groundhog</code> skill and local docs to
                            work from the same tools and instructions.
                        </p>
                        <a class="text-link" href={docsPath('/tutorials/build-a-counter/')}>
                            Build a counter, step by step{" "}
                            <span aria-hidden="true">↗</span>
                        </a>
                    </div>
                    <CounterExample />
                </div>
                <ol class="workflow" role="list">
                    {steps.map(([number, title, description, href]) => (
                        <li>
                            <a href={docsPath(href)}>
                                <span class="number">{number}</span>
                                <div>
                                    <h3>{title}</h3>
                                    <p>{description}</p>
                                </div>
                            </a>
                        </li>
                    ))}
                </ol>
            </div>
        </section>
        <div class="home-container">
            <ProjectFooter />
        </div>
    </div>
</StarlightPage>

<style>
    .home-page {
        isolation: isolate;
        color-scheme: only dark;
        background: var(--brand-background);
        color: var(--brand-foreground);
        font-family: var(--sl-font);
    }
    .home-container {
        width: calc(100% - 2.5rem);
        max-width: 77.5rem;
        margin-inline: auto;
    }
    .home-fallback,
    .hero-links {
        display: flex;
        flex-wrap: wrap;
        gap: 1rem 2rem;
    }
    .home-fallback {
        justify-content: center;
        padding: 1rem;
    }
    .home-page a {
        color: var(--sl-color-text-accent);
    }
    .home-page a:hover {
        text-decoration: underline;
        text-underline-offset: 0.25em;
    }
    #hero {
        position: relative;
        overflow: hidden;
        border-bottom: 1px solid var(--brand-border);
    }
    .hero-content {
        position: relative;
        padding-block: 5rem 3.5rem;
        text-align: center;
    }
    .eyebrow {
        margin: 0;
        font: 400 0.75rem/1.5 var(--sl-font-mono);
        letter-spacing: 0.06em;
        color: var(--brand-muted);
    }
    .home-page h1 {
        margin: 1.5rem 0;
        font-size: clamp(1.625rem, 6vw, 4.5rem);
        font-weight: 400;
        line-height: 1.1;
        letter-spacing: -0.06em;
        text-wrap: balance;
    }
    .hero-final-line {
        white-space: nowrap;
    }
    .abundance {
        color: var(--brand-accent);
    }
    .hero-description {
        max-width: 56ch;
        margin: 0 auto;
        font-size: 1.125rem;
        line-height: 1.6;
        text-wrap: pretty;
    }
    .hero-cursor {
        display: inline-block;
        width: 0;
        animation: cursor-blink 1.4s steps(1) infinite;
    }
    @keyframes cursor-blink {
        50% {
            opacity: 0;
        }
    }
    @media (prefers-reduced-motion: reduce) {
        .hero-cursor {
            animation: none;
        }
    }
    .hero-links {
        justify-content: center;
        margin-top: 1.75rem;
    }
    .hero-links a,
    .text-link {
        text-decoration: none;
    }
    .home-section {
        padding-block: 3.5rem;
        border-bottom: 1px solid var(--brand-border);
    }
    .home-section.developer-section {
        padding-block: 3.5rem;
    }
    .split {
        display: grid;
        grid-template-columns: minmax(0, 1fr);
        gap: 2.5rem;
        align-items: center;
    }
    .architecture-layout {
        display: grid;
        gap: 1.75rem;
    }
    .architecture-intro {
        align-items: start;
    }
    .home-page .architecture-heading h2 {
        max-width: none;
    }
    .section-copy {
        display: flex;
        flex-direction: column;
        align-items: start;
        gap: 1.25rem;
    }
    .home-page h2 {
        margin: 0;
        max-width: 24ch;
        font-size: clamp(1.75rem, 3vw, 2.5rem);
        font-weight: 400;
        line-height: 1.25;
        letter-spacing: -0.04em;
        text-wrap: balance;
    }
    .section-copy p:not(.eyebrow) {
        margin: 0;
        max-width: 56ch;
        color: var(--brand-muted);
        font-size: 1.125rem;
        line-height: 1.65;
    }
    .home-page h3 {
        margin: 0;
        font-size: 1.125rem;
        font-weight: 500;
        letter-spacing: -0.025em;
    }
    .differences {
        background: #141511;
    }
    .differences-layout {
        display: grid;
        gap: 2.5rem;
        align-items: start;
    }
    .difference-list {
        display: grid;
        gap: 2.5rem;
    }
    .difference-list article {
        display: flex;
        gap: 1.25rem;
        border-top: 1px solid var(--brand-border);
        padding-top: 1.5rem;
    }
    .difference-list article:first-child {
        border-top: 0;
        padding-top: 0;
    }
    .number {
        color: var(--brand-accent);
        font-family: var(--sl-font-mono);
    }
    .difference-list p {
        color: var(--brand-muted);
        line-height: 1.65;
    }
    .difference-list p {
        max-width: 56ch;
    }
    .workflow {
        display: grid;
        grid-template-columns: 1fr;
        gap: 1.5rem;
        list-style: none;
        padding: 1.5rem 0 0;
        margin: 2rem 0 0;
        border-top: 1px solid var(--brand-border);
    }
    .workflow li {
        min-width: 0;
    }
    .workflow a {
        display: flex;
        align-items: baseline;
        gap: 0.75rem;
        height: 100%;
        color: var(--brand-foreground);
        text-decoration: none;
    }
    .workflow a > div {
        display: flex;
        flex-direction: column;
        gap: 0.375rem;
    }
    .workflow .number {
        flex-shrink: 0;
    }
    .home-page .workflow a:hover {
        color: var(--brand-accent);
        text-decoration: none;
    }
    .workflow p {
        margin: 0;
        color: var(--brand-muted);
    }
    @media (min-width: 701px) {
        .home-container {
            width: calc(100% - 4rem);
        }
        .hero-content {
            padding-block: 6rem 4rem;
        }
        .home-section {
            padding-block: 5rem;
        }
        .split {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
        .difference-list {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
        .difference-list article:nth-child(2) {
            border-top: 0;
            padding-top: 0;
        }
        .workflow {
            grid-template-columns: repeat(5, minmax(0, 1fr));
            gap: 1.5rem;
        }
        .workflow a {
            font-size: 0.9375rem;
        }
    }
    @media (min-width: 1101px) {
        .home-container {
            width: calc(100% - 6rem);
        }
        .differences-layout {
            grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);
        }
    }
    @media (min-width: 1700px) {
        .home-container {
            max-width: 88.75rem;
        }
        .hero-content {
            padding-block: 4rem 5rem;
        }
        .home-page h1 {
            font-size: 5rem;
        }
    }
</style>
