---
import BrandLogo from './BrandLogo.astro';
---
<div class="brand-lockup">
  <BrandLogo />
  <span class="release-badge" aria-label="Technology preview: alpha-pre.1">alpha-pre.1</span>
</div>

<style>
  .brand-lockup { display: flex; flex-direction: column; align-items: flex-start; gap: .125rem; flex-shrink: 0; }
  .release-badge { padding: .125rem .375rem; border: 1px solid var(--brand-accent-tint); border-radius: 1rem; color: var(--sl-color-text-accent); background: var(--brand-accent-tint); font: 400 .6875rem/1.2 var(--sl-font-mono); white-space: nowrap; }
  :global([data-theme='light']) .release-badge { color: var(--brand-on-accent); background: var(--brand-accent); border-color: var(--brand-accent); }
  @media (min-width: 50rem) {
    .brand-lockup { flex-direction: row; align-items: center; gap: .625rem; }
    .release-badge { font-size: .6875rem; }
  }
</style>
