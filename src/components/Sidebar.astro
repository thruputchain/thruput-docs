---
import { docsPath } from '../../scripts/docs-routing.mjs';
import DefaultSidebar from '@astrojs/starlight/components/Sidebar.astro';
import SiteNavigation from './SiteNavigation.astro';
const isProjectPage = Astro.url.pathname === '/' || Astro.url.pathname === '/whitepapers/';
---

<SiteNavigation mobile />
{isProjectPage ? <a class="mobile-build" href={docsPath('/get-started/')}>Start Building</a> : <DefaultSidebar />}

<script is:inline>
  // Keep Starlight's saved disclosure state, but always reveal a deep link's page.
  (() => {
    let group = document.querySelector('.sidebar a[aria-current="page"]')?.closest('details');
    while (group) {
      group.open = true;
      group = group.parentElement?.closest('details');
    }
  })();
</script>

<style>
  .mobile-build { padding: .75rem 1rem; background: var(--brand-accent); color: var(--brand-on-accent); border-radius: .25rem; text-align: center; text-decoration: none; font: 600 1rem/1.5 var(--sl-font); }
</style>
