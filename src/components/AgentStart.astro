---
import guide from '../../public/agents/current.json';
const prompt = 'Read https://docs.groundhog.dev/start/build-with-an-agent/ and help me build my first Groundhog app. If you cannot access that page, ask me for a saved copy; never ask me to paste credentials. Check my setup, access, and the actual CLI and runtime paths first, then use the guidance from my installed CLI. Start with a small working contract, run its tests, and help me deploy it. Explain any changes that need my approval.';
---
<section class="agent-start" aria-labelledby="start-building">
  <div class="agent-start-intro">
    <p class="eyebrow">Start with your agent</p>
    <h2 id="start-building">An idea. An agent. A working contract.</h2>
    <p>Give your coding agent a starting point. Groundhog’s CLI carries the instructions for its own release.</p>
  </div>
  <div class="prompt-panel">
    <div class="prompt-toolbar">
      <span>Paste into your coding agent</span>
      <button type="button" data-copy-prompt hidden>Copy prompt</button>
    </div>
    <p class="agent-prompt" data-agent-prompt>{prompt}</p>
    <p class="copy-status" role="status" aria-live="polite"></p>
  </div>
  <div class="agent-start-footer">
    <p>Already installed? Give your agent <code>groundhog --skill</code>.</p>
    <a href="/start/build-with-an-agent/">Setup and agent guide <span aria-hidden="true">↗</span></a>
  </div>
  <p class="access-fallback">Agent can’t open the docs? <a href="/start/build-with-an-agent/" download="groundhog-agent-start.html">Save the setup page</a> from this browser and give your agent the file. Keep login credentials out of the conversation.</p>
  <p class="guide-version">Hosted reference: <a href={`/agents/${guide.version}/agent-guide.md`}>{guide.status === 'preview' ? 'preview' : 'release'} CLI {guide.version}</a>. Your installed CLI’s guidance takes precedence.</p>
</section>

<script>
  for (const panel of document.querySelectorAll<HTMLElement>('.agent-start')) {
    const button = panel.querySelector<HTMLButtonElement>('[data-copy-prompt]');
    const prompt = panel.querySelector<HTMLElement>('[data-agent-prompt]');
    const status = panel.querySelector<HTMLElement>('[role="status"]');
    if (!button || !prompt || !status) continue;
    button.hidden = false;
    button.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(prompt.textContent ?? '');
        status.textContent = 'Copied. Paste this into your coding agent.';
      } catch {
        status.textContent = 'Select the prompt above and copy it manually.';
      }
    });
  }
</script>
