<home-dot-field aria-hidden="true">
  <canvas id="dot-field"></canvas>
</home-dot-field>

<style>
  home-dot-field { display: contents; }
  canvas { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; color: var(--brand-accent); }
</style>

<script>
  interface Dot {
    x: number;
    y: number;
    radius: number;
    opacity: number;
    phase: number;
  }

  class HomeDotField extends HTMLElement {
    private cleanup?: () => void;

    connectedCallback() {
      const canvas = this.querySelector('canvas');
      const hero = this.closest('section');
      const context = canvas?.getContext('2d');
      if (!canvas || !hero || !context) return;

      const color = getComputedStyle(canvas).color;
      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
      let frame = 0;
      let sweepPhase = 0;
      let targetPhase = 0;
      let hovering = false;
      let lastTime = 0;
      let dots: Dot[] = [];

      const movePointer = (event: PointerEvent) => {
        if (event.pointerType === 'touch' || reducedMotion.matches) return;
        const bounds = hero.getBoundingClientRect();
        const x = (event.clientX - bounds.left) / bounds.width;
        const y = (event.clientY - bounds.top) / bounds.height;
        const phase = x * 0.9 + y * 0.22 + Math.sin(y * Math.PI * 2) * 0.08;
        // Choose the nearest repeated sweep to avoid a full-cycle jump on entry.
        targetPhase = phase + Math.round(sweepPhase - phase);
        hovering = true;
      };

      const releasePointer = () => {
        hovering = false;
        targetPhase = sweepPhase;
      };

      const draw = () => {
        // Clear physical pixels, including fractional CSS-size rounding.
        context.save();
        context.resetTransform();
        context.clearRect(0, 0, canvas.width, canvas.height);
        context.restore();
        context.fillStyle = color;
        for (const dot of dots) {
          const sweep = (0.5 + 0.5 * Math.cos((dot.phase - sweepPhase) * Math.PI * 2)) ** 4;
          context.globalAlpha = dot.opacity * (reducedMotion.matches ? 0.7 : 0.12 + sweep * 0.88);
          context.beginPath();
          context.arc(dot.x, dot.y, dot.radius, 0, Math.PI * 2);
          context.fill();
        }
        context.globalAlpha = 1;
      };

      const animate = (timestamp: number) => {
        if (reducedMotion.matches || document.hidden) return;
        const delta = Math.min((timestamp - lastTime) / 1000, 0.1);
        lastTime = timestamp;
        if (!hovering) targetPhase += delta / 9;
        // Frame-rate-independent easing lets the light trail the pointer.
        sweepPhase += (targetPhase - sweepPhase) * (1 - Math.exp(-delta / 0.45));
        draw();
        frame = requestAnimationFrame(animate);
      };

      const syncMotion = () => {
        cancelAnimationFrame(frame);
        if (reducedMotion.matches || document.hidden) releasePointer();
        draw();
        if (!reducedMotion.matches && !document.hidden) {
          lastTime = performance.now();
          frame = requestAnimationFrame(animate);
        }
      };

      hero.addEventListener('pointermove', movePointer);
      hero.addEventListener('pointerleave', releasePointer);
      hero.addEventListener('pointercancel', releasePointer);
      window.addEventListener('blur', releasePointer);
      reducedMotion.addEventListener('change', syncMotion);
      document.addEventListener('visibilitychange', syncMotion);

      const observer = new ResizeObserver(() => {
        const bounds = canvas.getBoundingClientRect();
        const width = bounds.width;
        const height = bounds.height;
        const ratio = Math.min(window.devicePixelRatio || 1, 2);
        canvas.width = Math.round(width * ratio);
        canvas.height = Math.round(height * ratio);
        context.setTransform(ratio, 0, 0, ratio, 0, 0);
        dots = [];
        const spacing = width < 600 ? 12 : 11;
        // Leave a grid cell clear around the canvas so no circles are clipped.
        for (let y = spacing; y < height - spacing; y += spacing) {
          for (let x = spacing; x < width - spacing; x += spacing) {
            const nx = x / width;
            const ny = y / height;
            const ribbon = Math.exp(-(((ny - 0.48 - Math.sin(nx * 6) * 0.37) / 0.31) ** 2));
            const edge = Math.min(1, nx * 10, (1 - nx) * 10, ny * 12, (1 - ny) * 8);
            const centerFade = 1 - 0.72 * Math.exp(-(((nx - 0.5) / 0.27) ** 2) - ((ny - 0.43) / 0.3) ** 2);
            dots.push({
              x, y,
              radius: 0.65 + ribbon * 2.3,
              opacity: (0.24 + ribbon * 0.48) * edge * centerFade,
              phase: nx * 0.9 + ny * 0.22 + Math.sin(ny * Math.PI * 2) * 0.08,
            });
          }
        }
        draw();
      });
      observer.observe(canvas);
      syncMotion();

      this.cleanup = () => {
        observer.disconnect();
        cancelAnimationFrame(frame);
        hero.removeEventListener('pointermove', movePointer);
        hero.removeEventListener('pointerleave', releasePointer);
        hero.removeEventListener('pointercancel', releasePointer);
        window.removeEventListener('blur', releasePointer);
        reducedMotion.removeEventListener('change', syncMotion);
        document.removeEventListener('visibilitychange', syncMotion);
      };
    }

    disconnectedCallback() {
      this.cleanup?.();
    }
  }

  customElements.define('home-dot-field', HomeDotField);
</script>
