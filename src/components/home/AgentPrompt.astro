---
import { docsPath } from '../../../scripts/docs-routing.mjs';
import { Icon } from '@astrojs/starlight/components';
import CopyIcon from '../CopyIcon.astro';
import onboarding from '../../content/docs/start/build-with-an-agent.md?raw';
const rawPrompt = onboarding.match(/```text\r?\n([\s\S]*?)\r?\n```/)?.[1];
if (!rawPrompt) throw new Error('Agent onboarding must include a text prompt.');
const prompt = rawPrompt;
---

<home-agent-prompt data-local-snapshot={process.env.THRUPUT_DOCS_SNAPSHOT ? 'true' : undefined} role="group" aria-labelledby="install-label">
  <div id="install-label">Start with your coding agent</div>
  <div class="prompt-bar">
    <button type="button" class="prompt-preview" data-preview aria-label="Preview setup prompt" aria-haspopup="dialog" hidden>
      <span data-preview-text>{prompt}</span><span class="preview-label">Preview <span aria-hidden="true">↗</span></span>
    </button>
    <button type="button" class="copy-button" data-copy hidden><CopyIcon /><span data-button-label>Copy prompt</span></button>
  </div>
  <p class="copy-status" role="status" aria-live="polite" data-copy-status></p>
  <dialog aria-labelledby="prompt-title" aria-describedby="prompt-outcome">
    <div class="prompt-dialog">
      <div class="dialog-heading"><h2 id="prompt-title">Deploy your first counter</h2><form method="dialog"><button type="submit" class="close-button" aria-label="Close prompt preview"><Icon name="close" size="1.25rem" /></button></form></div>
      <p id="prompt-outcome">Install the tools, fund a Futurenet wallet, and verify a counter value of 15 using the CLI.</p>
      <textarea name="agent-prompt" aria-label="Full agent prompt" readonly rows="13">{prompt}</textarea>
      <p data-dialog-feedback role="status" aria-live="polite"></p>
      <div class="dialog-actions"><button type="button" class="copy-button primary" data-copy><CopyIcon /><span data-button-label>Copy prompt</span></button><a href={docsPath('/get-started/contract/')}>Follow the guided quickstart ↗</a></div>
    </div>
  </dialog>
  <noscript><details><summary>View full prompt to copy manually</summary><textarea name="agent-prompt-fallback" aria-label="Full agent prompt" readonly rows="13">{prompt}</textarea></details></noscript>
</home-agent-prompt>

<style>
  home-agent-prompt { display: block; margin: 3rem auto 0; width: 100%; max-width: 38rem; text-align: left; }
  #install-label { margin-bottom: .75rem; font: 400 .8125rem/1.5 var(--sl-font-mono); color: var(--brand-muted); text-align: center; }
  .prompt-bar { display: flex; align-items: center; gap: .5rem; min-width: 0; padding: .5rem; border: 1px solid var(--brand-border); border-radius: .375rem; background: var(--brand-background); }
  .prompt-bar:has([data-preview][hidden]) { display: none; }
  button { cursor: pointer; font: 500 .875rem/1.5 var(--sl-font); color: var(--brand-foreground); }
  .prompt-preview { display: flex; align-items: center; gap: .75rem; flex: 1; min-width: 0; padding: .625rem .5rem; border: 0; border-radius: .25rem; background: transparent; text-align: left; }
  [data-preview-text] { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: var(--brand-muted); }
  .preview-label { flex-shrink: 0; color: var(--brand-foreground); }
  .prompt-preview:hover { background: var(--brand-surface); }
  .copy-button { display: inline-flex; align-items: center; justify-content: center; flex-shrink: 0; gap: .5rem; min-height: 2.5rem; padding: .5rem .75rem; border: 1px solid var(--brand-border); border-radius: .25rem; background: var(--brand-surface); }
  .copy-button:hover { border-color: var(--brand-accent); }
  :global(.copy-button svg) { flex-shrink: 0; }
  [hidden] { display: none !important; }
  .copy-status { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); }
  dialog { position: fixed; inset: 0; margin: auto; width: min(44rem, calc(100vw - 2rem)); height: fit-content; max-width: none; max-height: calc(100dvh - 2rem); padding: 1.5rem; border: 1px solid var(--brand-border); border-radius: .5rem; background: var(--brand-background); color: var(--brand-foreground); }
  dialog::backdrop { background: rgb(0 0 0 / .75); }
  .prompt-dialog { display: flex; flex-direction: column; gap: 1.25rem; }
  .dialog-heading { display: flex; align-items: center; justify-content: space-between; gap: 1rem; }
  .dialog-heading h2 { margin: 0; font: 500 1.25rem var(--sl-font-mono); text-align: left; }
  .dialog-heading form { margin: 0; }
  .close-button { display: flex; align-items: center; justify-content: center; width: 2.5rem; height: 2.5rem; border: 0; border-radius: .25rem; background: transparent; }
  .close-button:hover { background: var(--brand-surface); }
  .prompt-dialog p { margin: 0; color: var(--brand-muted); }
  [data-dialog-feedback]:empty { display: none; }
  textarea { width: 100%; max-height: 45dvh; padding: 1rem; border: 1px solid var(--brand-border); border-radius: .25rem; background: var(--brand-surface); color: var(--brand-foreground); font: 400 1rem/1.65 var(--sl-font-mono); resize: vertical; }
  textarea:focus-visible { outline-offset: -1px; }
  .dialog-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 1rem; }
  .primary { background: var(--brand-accent); color: var(--brand-on-accent); border-color: var(--brand-accent); }
  .primary:hover { background: var(--brand-accent-hover); }
  .dialog-actions a { color: var(--brand-accent); text-decoration: underline; text-underline-offset: .2em; }
  details { margin-top: 1rem; color: var(--brand-muted); }
  summary { cursor: pointer; }
  @media (min-width: 40rem) { textarea { font-size: .875rem; } }
  @media (max-width: 24rem) { .preview-label { display: none; } }
  @media (pointer: coarse) { .copy-button, .close-button, .prompt-preview { min-height: 3rem; } .close-button { min-width: 3rem; } }
</style>

<script>
  class HomeAgentPrompt extends HTMLElement {
    private cleanup?: () => void;
    connectedCallback() {
      const controller = new AbortController();
      let timer = 0;
      let opener: HTMLElement | null = null;
      const dialog = this.querySelector('dialog')!;
      const preview = this.querySelector<HTMLButtonElement>('[data-preview]')!;
      const textarea = dialog.querySelector('textarea')!;
      const status = this.querySelector<HTMLElement>('[data-copy-status]')!;
      const dialogFeedback = this.querySelector<HTMLElement>('[data-dialog-feedback]')!;
      const buttons = this.querySelectorAll<HTMLButtonElement>('[data-copy]');
      if (this.dataset.localSnapshot) {
        textarea.value = textarea.value.replaceAll('https://thruput.network/docs/', `${location.origin}/`);
        this.querySelector('[data-preview-text]')!.textContent = textarea.value;
      }
      const open = (trigger: HTMLElement) => {
        if (!dialog.open) { opener = trigger; dialog.showModal(); }
      };
      preview.hidden = false;
      preview.addEventListener('click', () => { dialogFeedback.textContent = ''; open(preview); }, { signal: controller.signal });
      dialog.addEventListener('close', () => opener?.focus(), { signal: controller.signal });
      dialog.addEventListener('keydown', event => {
        if (event.key !== 'Tab') return;
        const controls = [...dialog.querySelectorAll<HTMLElement>('button, textarea, a[href]')];
        const first = controls[0];
        const last = controls.at(-1);
        if (event.shiftKey && document.activeElement === first) { event.preventDefault(); last?.focus(); }
        else if (!event.shiftKey && document.activeElement === last) { event.preventDefault(); first?.focus(); }
      }, { signal: controller.signal });
      buttons.forEach(button => {
        button.hidden = false;
        button.addEventListener('click', async () => {
          window.clearTimeout(timer);
          try {
            await navigator.clipboard.writeText(textarea.value);
            if (!this.isConnected) return;
            status.textContent = 'Prompt copied to clipboard.';
            dialogFeedback.textContent = '';
            buttons.forEach(item => { item.querySelector('[data-button-label]')!.textContent = 'Copied'; });
            timer = window.setTimeout(() => {
              buttons.forEach(item => { item.querySelector('[data-button-label]')!.textContent = 'Copy prompt'; });
              status.textContent = '';
            }, 2_000);
          } catch {
            if (!this.isConnected) return;
            const message = 'Clipboard access was blocked. Copy the selected full prompt below.';
            status.textContent = message;
            dialogFeedback.textContent = message;
            open(button);
            textarea.focus();
            textarea.select();
          }
        }, { signal: controller.signal });
      });
      this.cleanup = () => { controller.abort(); window.clearTimeout(timer); };
    }
    disconnectedCallback() { this.cleanup?.(); }
  }
  if (!customElements.get('home-agent-prompt')) customElements.define('home-agent-prompt', HomeAgentPrompt);
</script>
