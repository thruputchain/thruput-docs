---
// Approximate points read from the supplied historical ERC-20 execution chart.
// Normalize its scaling curve to the requested 700K single-machine baseline.
// Replace these estimates with measured data after the benchmark rerun.
const previousRates = [475_000, 850_000, 1_280_000, 1_640_000, 2_000_000];
const baseline = 700_000;
const rates = previousRates.map((rate, index) => ({
    machines: index + 1,
    rate: rate * baseline / previousRates[0],
}));
const formatRate = (rate: number) => rate < 1_000_000 ? `${Math.round(rate / 1_000)}K` : `${(rate / 1_000_000).toFixed(2)}M`;
const ceiling = 3_200_000;
---

<figure class="execution-scaling" aria-labelledby="scaling-title" aria-describedby="scaling-basis">
    <div class="chart-heading">
        <div>
            <h3 id="scaling-title">More machines. More work.</h3>
            <p class="chart-workload">ERC-20 payments / second</p>
        </div>
        <div class="chart-highlight">
            <strong>~3M</strong>
            <span>payments / sec · 5 machines</span>
        </div>
    </div>
    <div class="plot">
        <div class="gridlines" aria-hidden="true">
            {[3_000_000, 2_000_000, 1_000_000, 0].map(rate => <div class="gridline" style={`bottom: ${rate / ceiling * 100}%`}><span>{rate === 0 ? '0' : `${rate / 1_000_000}M`}</span></div>)}
        </div>
        <ol class="bars" role="list" aria-label="Extrapolated payment throughput by machine count">
            {rates.map(({ machines, rate }) => <li aria-label={`${machines} ${machines === 1 ? 'machine' : 'machines'}: approximately ${Math.round(rate).toLocaleString('en-US')} payments per second`}>
                <div class="bar" style={`height: ${rate / ceiling * 100}%`}><span class="bar-value">{formatRate(rate)}</span></div>
                <span class="machine-count">{machines}</span>
            </li>)}
        </ol>
    </div>
    <p class="axis-label">Machines per validator</p>
    <figcaption id="scaling-basis">
        Prior ERC-20 execution scaling, normalized to a 700K payments/sec
        single-machine baseline (64 cores). Multi-machine values are estimates,
        pending a benchmark rerun.
    </figcaption>
</figure>

<style>
    .execution-scaling { margin: 0; padding-top: 1.5rem; border-top: 1px solid var(--brand-border); }
    .chart-heading { display: flex; align-items: end; justify-content: space-between; flex-wrap: wrap; gap: 1rem; margin-bottom: 2.25rem; }
    h3 { margin: 0; color: var(--brand-foreground); font-size: clamp(1.25rem, 2vw, 1.5rem); font-weight: 400; line-height: 1.25; letter-spacing: -.04em; }
    .chart-workload { margin: .5rem 0 0; color: var(--brand-muted); font-size: .9375rem; }
    .chart-highlight { display: flex; flex-direction: column; gap: .375rem; }
    .chart-highlight strong { color: var(--brand-accent); font: 400 clamp(2.5rem, 4vw, 3rem)/1 var(--sl-font-mono); letter-spacing: -.06em; }
    .chart-highlight > span { color: var(--brand-muted); font: 400 .8125rem/1.5 var(--sl-font-mono); }
    .plot { position: relative; height: clamp(9rem, 14vw, 12rem); margin-left: 2.5rem; }
    .gridlines { position: absolute; inset: 0; }
    .gridline { position: absolute; width: 100%; border-bottom: 1px solid var(--brand-border); }
    .gridline > span { position: absolute; right: calc(100% + .75rem); transform: translateY(-50%); color: var(--brand-muted); font: 400 .75rem/1 var(--sl-font-mono); }
    .bars { position: relative; display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: clamp(.75rem, 4vw, 4rem); height: 100%; margin: 0; padding: 0 clamp(.25rem, 2vw, 2rem); list-style: none; }
    .bars li { position: relative; display: flex; align-items: end; justify-content: center; min-width: 0; height: 100%; }
    .bar { position: relative; width: 65%; border-radius: .5rem .5rem 0 0; background: var(--brand-accent); }
    .bar-value { position: absolute; top: -1.75rem; left: 50%; transform: translateX(-50%); color: var(--brand-accent); font: 400 clamp(.6875rem, 1.5vw, 1rem)/1 var(--sl-font-mono); white-space: nowrap; }
    .machine-count { position: absolute; top: calc(100% + .875rem); left: 50%; transform: translateX(-50%); color: var(--brand-foreground); font: 400 .875rem/1 var(--sl-font-mono); }
    .axis-label { margin: 2.5rem 0 0 2.5rem; color: var(--brand-muted); text-align: center; font: 400 .75rem/1.5 var(--sl-font-mono); }
    figcaption { max-width: 80ch; margin: 1rem auto 0; color: var(--brand-muted); text-align: center; font-size: .8125rem; line-height: 1.6; }
    @media (max-width: 700px) {
        .chart-heading { align-items: start; }
        .chart-highlight strong { font-size: 2.5rem; }
        .bars { gap: .75rem; }
    }
</style>
