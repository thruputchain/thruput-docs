---
import { docsPath } from '../../scripts/docs-routing.mjs';
interface Props { mobile?: boolean }
const { mobile = false } = Astro.props;
const isHome = Astro.url.pathname === '/';
const isWhitepapers = Astro.url.pathname === '/whitepapers/';
const links = [
  { label: 'About', href: '/architecture/' },
  { label: 'Whitepapers', href: '/whitepapers/' },
  { label: 'Documentation', href: '/get-started/' },
  { label: 'Community', href: 'https://github.com/thruputchain/thruput-docs/discussions' },
  { label: 'Discord', href: 'https://discord.com/channels/897514728459468821/1564948118162898954' },
];
---

<nav class:list={['site-navigation', { mobile }]} aria-label="Main navigation">
  <ul role="list">
    {links.map(({ label, href }) => (
      <li><a href={docsPath(href)} aria-current={isWhitepapers && label === 'Whitepapers' ? 'page' : !isHome && !isWhitepapers && label === 'Documentation' ? 'location' : undefined}>{label}</a></li>
    ))}
  </ul>
</nav>

<style>
  .site-navigation { display: none; min-width: 0; font: 400 .875rem/1.5 var(--sl-font); }
  ul { display: flex; align-items: center; gap: .5rem; list-style: none; margin: 0; padding: 0; }
  li { flex-shrink: 0; }
  a { display: flex; align-items: center; min-height: 2.75rem; padding-block: .5rem; color: var(--brand-foreground); text-decoration: none; white-space: nowrap; }
  a:hover, a[aria-current] { color: var(--sl-color-text-accent); }
  :global([data-theme='light']) a:hover,
  :global([data-theme='light']) a[aria-current] {
    color: var(--brand-foreground);
    text-decoration: underline;
    text-decoration-color: var(--brand-accent);
    text-decoration-thickness: 2px;
    text-underline-offset: .25em;
  }
  .mobile { display: block; padding-bottom: 1rem; border-bottom: 1px solid var(--brand-border); font-size: 1rem; }
  .mobile ul { flex-direction: column; align-items: stretch; gap: .25rem; }
  .mobile a { min-height: 3rem; padding-inline: .5rem; white-space: normal; }
  @media (min-width: 50rem) { .site-navigation { display: block; } .mobile { display: none; } }
  @media (min-width: 60rem) { ul { gap: 1rem; } }
  @media (min-width: 1200px) { ul { gap: 1.5rem; } }
</style>
