---
import { Icon } from '@astrojs/starlight/components';
---

<starlight-menu-button class="print:hidden">
  <button type="button" aria-expanded="false" aria-label={Astro.locals.t('menuButton.accessibleLabel')} aria-controls="starlight__sidebar">
    <Icon name="bars" class="open-menu" />
    <Icon name="close" class="close-menu" />
  </button>
</starlight-menu-button>

<noscript><style>starlight-menu-button { display: none; }</style></noscript>

<script>
  class SiteMenuButton extends HTMLElement {
    private cleanup?: () => void;

    connectedCallback() {
      const button = this.querySelector('button');
      const navigation = this.closest('nav');
      const content = document.querySelector<HTMLElement>('.main-frame');
      if (!button || !navigation) return;
      const desktop = matchMedia('(min-width: 50rem)');
      const setExpanded = (expanded: boolean) => {
        // PageFrame uses the host attribute to control the sibling sidebar's visibility.
        this.setAttribute('aria-expanded', String(expanded));
        button.setAttribute('aria-expanded', String(expanded));
        document.body.toggleAttribute('data-mobile-menu-expanded', expanded);
        if (content) content.inert = expanded;
      };
      const toggle = () => setExpanded(button.getAttribute('aria-expanded') !== 'true');
      const closeOnEscape = (event: KeyboardEvent) => {
        if (event.key !== 'Escape' || document.querySelector('dialog[open]') || button.getAttribute('aria-expanded') !== 'true') return;
        setExpanded(false);
        button.focus();
      };
      const closeOnLink = (event: MouseEvent) => {
        if (event.target instanceof Element && event.target.closest('a[href]')) setExpanded(false);
      };
      const closeOnDesktop = () => { if (desktop.matches) setExpanded(false); };
      button.addEventListener('click', toggle);
      document.addEventListener('keydown', closeOnEscape);
      document.addEventListener('click', closeOnLink);
      desktop.addEventListener('change', closeOnDesktop);
      this.cleanup = () => {
        button.removeEventListener('click', toggle);
        document.removeEventListener('keydown', closeOnEscape);
        document.removeEventListener('click', closeOnLink);
        desktop.removeEventListener('change', closeOnDesktop);
        document.body.removeAttribute('data-mobile-menu-expanded');
        if (content) content.inert = false;
      };
    }

    disconnectedCallback() { this.cleanup?.(); }
  }
  customElements.define('starlight-menu-button', SiteMenuButton);
</script>

<style>
  button {
    display: flex;
    align-items: center;
    justify-content: center;
    position: fixed;
    top: calc((var(--sl-nav-height) - var(--sl-menu-button-size)) / 2);
    inset-inline-end: var(--sl-nav-pad-x);
    z-index: var(--sl-z-index-navbar);
    width: var(--sl-menu-button-size);
    height: var(--sl-menu-button-size);
    padding: .5rem;
    border: 1px solid var(--brand-border);
    border-radius: .25rem;
    background: var(--brand-surface);
    color: var(--brand-foreground);
    cursor: pointer;
  }
  button:hover { border-color: var(--sl-color-text-accent); }
  button :global(svg) { width: 1.25rem; height: 1.25rem; }
  [aria-expanded='true'] :global(.open-menu),
  button[aria-expanded='false'] :global(.close-menu) { display: none; }
  :global(body[data-mobile-menu-expanded]) { overflow: hidden; }
  @media (min-width: 50rem) { button { display: none; } }
</style>
