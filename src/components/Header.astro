---
import { docsPath } from '../../scripts/docs-routing.mjs';
import Search from '@astrojs/starlight/components/Search.astro';
import SiteNavigation from './SiteNavigation.astro';
import ThemeSelect from './ThemeSelect.astro';
import BrandIdentity from './BrandIdentity.astro';
---

<div class:list={['site-header', { 'home-header': Astro.url.pathname === '/' }]}>
  <BrandIdentity />
  <SiteNavigation />
  <div class="header-actions">
    <Search />
    <a class="build-link" href={docsPath('/get-started/')}>Start Building</a>
    {Astro.url.pathname !== '/' && <div class="desktop-theme"><ThemeSelect /></div>}
  </div>
</div>

<style>
  .site-header { display: flex; align-items: center; gap: 1rem; height: 100%; min-width: 0; font-family: var(--sl-font); }
  .home-header { max-width: 77.5rem; margin-inline: auto; }
  .header-actions { display: flex; align-items: center; gap: .75rem; margin-left: auto; min-width: 0; }
  .desktop-theme, .build-link { display: none; }
  .build-link { align-items: center; justify-content: center; min-height: 2.25rem; padding: .5rem 1rem; border-radius: .25rem; background: var(--brand-accent); color: #10110f; font-size: .875rem; line-height: 1.25rem; font-weight: 500; text-decoration: none; white-space: nowrap; }
  .build-link:hover { background: #f2f68e; }
  @media (min-width: 50rem) { .desktop-theme { display: block; } }
  @media (min-width: 1200px) { .site-header { gap: 1.5rem; } .build-link { display: inline-flex; } }
  @media (min-width: 1700px) { .home-header { max-width: 88.75rem; } }
</style>
