{
	admin off
	persist_config off
	auto_https off

	log {
		format json
	}

	servers {
		trusted_proxies static private_ranges 100.0.0.0/8
	}
}

:{$PORT:80} {
	log {
		format json
	}

	header {
		X-Content-Type-Options "nosniff"
		-Server
	}

	root * {$SITE_ROOT:/app/dist}
	encode gzip zstd
	route {
		respond /health 200

		import {$SITE_ROOT:/app/dist}/docs-redirects.caddy

		@oldDocsRoot {
			host docs.thruput.network docs.groundhog.dev
			path /
		}
		redir @oldDocsRoot https://www.thruput.network/docs{uri} 308

		@oldDocsPage {
			host docs.thruput.network docs.groundhog.dev
			path_regexp docs ^/(architecture|get-started|start|cli|contracts|typescript|react|guides|tools|reference|tutorials|programming-model|how-it-works|ecosystem)(/|$)
		}
		redir @oldDocsPage https://www.thruput.network/docs{uri} 308

		@aliasHosts host thruput.network docs.thruput.network docs.groundhog.dev
		redir @aliasHosts https://www.thruput.network{uri} 308

		try_files {path} {path}.html {path}/index.html
		# Show Markdown as source, even when it starts with an HTML anchor.
		@markdown {
			path *.md
			file {path}
		}
		header @markdown Content-Type "text/plain; charset=utf-8"
		file_server {
			hide .git
			hide .env*
			hide *.caddy
		}
	}
}
