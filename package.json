  "type": "module",
  "version": "0.0.1",
  "packageManager": "pnpm@11.5.2",
  "engines": {
    "node": ">=22.23.4 <23"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "node scripts/check-agent-guide.mjs && astro build",
